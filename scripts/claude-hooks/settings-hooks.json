{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/bitacora-sesion.sh\" inicio",
            "timeout": 15,
            "suppressOutput": true,
            "statusMessage": "Resolviendo la cuenta activa..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/guardia/relevo.mjs\" inicio",
            "timeout": 60,
            "asyncRewake": true,
            "rewakeMessage": "Relevo tras la caída de la app:",
            "rewakeSummary": "Retomando tras la caída de la app"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/bitacora-sesion.sh\" fin",
            "timeout": 30,
            "suppressOutput": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/bitacora-sesion.sh\" turno",
            "timeout": 60,
            "suppressOutput": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/guardia/relevo.mjs\" turno",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Workflow|Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$HOME/.claude/guardia/memoria.mjs\"",
            "timeout": 300,
            "statusMessage": "Guardia de RAM..."
          }
        ]
      }
    ]
  }
}