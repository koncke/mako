# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Material de especificación (no versionar)
Mejoras_v3_MauricioBustos.pdf
*.mejoras.pdf

# Closing Analyst v2 — archivos de trabajo (transcripts/análisis temporales)
scripts/_closing_work/
scripts/_closing_work_out/
scripts/_closing_rids.json

# graphify knowledge graph (generado por-dev: pipx install graphifyy && graphify update .)
graphify-out/

# hook local de graphify (always-on por-maquina; requiere graphify en PATH)
.claude/settings.local.json

# Tooling de Claude Code (no va al repo)
.agents/
skills-lock.json

# Cachés de Python de las skills (las genera correr un script de una skill)
__pycache__/

# Respaldos de datos REALES (scripts/checklists-a-bullets.mts y compañía). Nunca van a
# git: son filas de clientes, y un respaldo versionado es una fuga con historial.
backups/
# Lo mismo para el respaldo del store de /mensajes, que lo escribe
# scripts/respaldo-store-plantillas.ts antes de verificar la pantalla en el navegador:
# es el contenido de un workspace real, y vive en la raíz porque el script corre ahí.
.respaldo-store-plantillas-ws*.json
.respaldo-posiciones-ws*.json
