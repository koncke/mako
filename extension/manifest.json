{
  "manifest_version": 3,
  "name": "MaKo",
  "version": "0.78.0",
  "description": "Conecta tu navegador con MaKo: tus contactos de WhatsApp al CRM, anuncios con tu Google Flow y competidores con un clic.",
  "permissions": [
    "storage",
    "alarms",
    "webRequest",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://hola-mako.com/*",
    "https://labs.google/*",
    "https://flow.google.com/*",
    "https://aisandbox-pa.googleapis.com/*",
    "https://web.whatsapp.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/*/tools/flow*",
        "https://flow.google.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://labs.google/fx/tools/flow*",
        "https://labs.google/fx/*/tools/flow*",
        "https://flow.google.com/*"
      ],
      "js": [
        "injected.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://flow.google.com/*"
      ],
      "js": [
        "flow-interfaz.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://hola-mako.com/*",
        "http://localhost/*",
        "http://localhost:*/*"
      ],
      "js": [
        "mako-puente.js"
      ],
      "run_at": "document_start",
      "exclude_matches": [
        "https://hola-mako.com/api/*",
        "https://hola-mako.com/l/*"
      ]
    },
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "wa-fichas-reglas.js",
        "wa-fichas.js",
        "wa-recorrer.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "icons": {
    "16": "icon-16.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  }
}
